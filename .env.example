# Copy to `.env` and adjust. Used by docker-compose.yml. Never commit real secrets.

# --- PostgreSQL (Web / Docker) ----------------------------------------------
# Database name and user created inside the postgres container.
POSTGRES_DB=shader_studio
POSTGRES_USER=shader_studio
# Required — Compose refuses to start without it. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# The connection string the app uses. Compose builds this for you from the three
# values above, so you normally do NOT need to set it here. Override only if you
# point the app at an external PostgreSQL instead of the bundled one.
# DATABASE_URL=postgres://shader_studio:change-me@postgres:5432/shader_studio

# --- App ---------------------------------------------------------------------
# Host port the app is published on (container always listens on 4000).
SHADER_PORT=4000

# Comma-separated hostnames the SSR engine will answer for. Add your machine
# name or domain when reaching the app as something other than localhost.
SHADER_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Authentication ----------------------------------------------------------
# Required in production; the server refuses to start without these three.
#
# A long random secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
# The origin browsers actually reach this server at, including the scheme. It is
# what verification and password-reset links are built from, and the only origin
# allowed to drive a cookie-authenticated request.
BETTER_AUTH_URL=https://shaders.example.com
# SMTP for verification and password-reset mail. Without it nobody can confirm
# an address or recover an account, so production will not start.
MAIL_SMTP_URL=smtp://user:password@mail.example.com:587
MAIL_FROM=Shadergrove <no-reply@shaders.example.com>

# Extra origins allowed to drive a cookie-authenticated request, comma
# separated. Keep this empty unless you genuinely serve the app from more than
# one origin — every entry is a site that may act with your users' sessions.
# AUTH_TRUSTED_ORIGINS=

# `open` (anyone may sign up) or `invite-only` (sign-in still works, sign-up is
# closed). Use invite-only for a private or self-hosted instance.
AUTH_REGISTRATION=open

# Set to 0 only if you have no mail provider and accept that an unverified
# address can then reset a password. Verification is required by default.
# AUTH_REQUIRE_VERIFIED_EMAIL=1

# Session lifetime. The first is the idle window (an active session keeps being
# extended), the second the hard ceiling it can never pass.
# AUTH_SESSION_IDLE_SECONDS=604800
# AUTH_SESSION_MAX_SECONDS=2592000

# Set to 1 ONLY when this server sits behind a reverse proxy you control.
# It makes `x-forwarded-for` believed, which is what per-IP throttling and the
# audit log key on — so a forged header would let a caller pick their own
# rate-limit bucket. Leave it off when the app is exposed directly.
TRUST_PROXY=0

# New passwords are checked against the Have I Been Pwned corpus (only the first
# five characters of a SHA-1 hash ever leave the server). The check fails
# closed: if the service is unreachable, sign-up and password reset are refused.
# Set to 0 on an air-gapped deployment.
# AUTH_CHECK_COMPROMISED_PASSWORDS=1

# Per-IP throttling on the credential endpoints. Leave it on.
# AUTH_RATE_LIMIT=1

# --- Public Explore ----------------------------------------------------------
# Set to 1 to let verified users publish snapshots of their shaders for anyone
# to browse and copy. Off by default; turning it back off closes every public
# route again and leaves the published data in place.
PUBLIC_EXPLORE_ENABLED=0
# Accounts that may moderate, as comma-separated account ids (the `user.id`
# that /api/auth/get-session returns for them), not email addresses. Empty
# means nobody can hide a publication or restrict a publisher — set at least
# one before enabling Explore.
# PUBLIC_EXPLORE_ADMIN_USER_IDS=

# --- Public desktop release catalogue ---------------------------------------
# Optional server-only GitHub token for a higher API quota. The catalogue is
# always public and only reads published antelm-dev/shadergrove releases.
# Never pass this token to a NEXT_PUBLIC_* variable or to the website image.
# GITHUB_RELEASES_TOKEN=
