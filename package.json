{
  "name": "shadergrove",
  "version": "2.8.0",
  "private": true,
  "description": "A shader collection viewer and editor: browse, edit, tune and share WebGL shaders.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Adel Terki",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "dev": "nx run @shadergrove/studio:dev",
    "dev:server": "nx run @shadergrove/studio:dev:server",
    "dev:desktop": "nx run @shadergrove/studio:dev:desktop",
    "dev:mcp": "nx run @shader-studio/mcp:dev",
    "dev:website": "nx run @shadergrove/website:dev",
    "build": "nx run @shadergrove/studio:build",
    "build:all": "nx run-many -t build --projects \"@shadergrove/studio,@shadergrove/website,@shader-studio/mcp\" && nx run @shadergrove/maintenance:build:cli",
    "build:desktop": "nx run @shadergrove/studio:build:desktop",
    "build:mcp": "nx run @shader-studio/mcp:build",
    "build:website": "nx run @shadergrove/website:build",
    "serve:ssr": "node dist/shadergrove/server/server.mjs",
    "test": "nx run-many -t test --projects \"@shadergrove/*,@shader-studio/mcp\"",
    "test:watch": "nx run @shadergrove/studio:test:watch",
    "test:mcp": "nx run @shader-studio/mcp:test",
    "typecheck": "pnpm gen:ipc && pnpm typecheck:scripts && nx run-many -t typecheck --projects \"@shadergrove/*,@shader-studio/mcp\"",
    "typecheck:mcp": "nx run @shader-studio/mcp:typecheck",
    "typecheck:scripts": "nx run @shadergrove/workspace-tools:typecheck",
    "check": "pnpm check:i18n && pnpm check:fonts && pnpm check:ipc && pnpm check:plugins",
    "check:i18n": "nx run @shadergrove/workspace-tools:check:i18n",
    "check:fonts": "nx run @shadergrove/workspace-tools:check:fonts",
    "check:ipc": "nx run @shadergrove/workspace-tools:check:ipc",
    "check:plugins": "nx run @shadergrove/workspace-tools:check:plugins",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "smoke": "nx run @shadergrove/workspace-tools:smoke",
    "smoke:website": "nx run @shadergrove/workspace-tools:smoke:website",
    "e2e": "nx run @shadergrove/studio-e2e:e2e",
    "gen:ipc": "nx run @shadergrove/studio:gen:ipc",
    "gen:fonts": "nx run @shadergrove/workspace-tools:generate:fonts",
    "gen:plugins": "nx run @shadergrove/workspace-tools:generate:plugins",
    "pack:desktop": "nx run @shadergrove/studio:pack:dir",
    "pack:win": "nx run @shadergrove/studio:pack:win",
    "dist:win": "nx run @shadergrove/studio:dist:win",
    "pack:linux": "nx run @shadergrove/studio:pack:linux",
    "dist:linux": "nx run @shadergrove/studio:dist:linux",
    "dist:mac": "nx run @shadergrove/studio:dist:mac",
    "pack:mcp": "nx run @shader-studio/mcp:pack:tarball",
    "verify:mcp": "nx run @shader-studio/mcp:verify",
    "affected": "nx affected",
    "graph": "nx graph",
    "ci": "pnpm lint && pnpm format:check && pnpm check && pnpm typecheck && pnpm test && pnpm build:all && pnpm smoke:ssr",
    "smoke:ssr": "nx run @shadergrove/workspace-tools:smoke:ssr"
  },
  "dependencies": {
    "@nestjs/swagger": "11.4.6",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@nx/angular": "23.2.1",
    "@nx/nest": "23.2.1",
    "@shadergrove/shared": "workspace:*",
    "nx": "23.2.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "volta": {
    "node": "26.5.0"
  },
  "packageManager": "pnpm@10.28.2"
}
