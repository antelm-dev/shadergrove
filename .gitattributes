# oxfmt emits LF. Keep formatted source, docs and config stable on Windows.
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bru text eol=lf
*.html text eol=lf
*.fs text eol=lf
# Upstream snapshots must stay byte-identical to the pinned commit (checked by tools/glsl-analysis).
third_party/** -text
# Generated by tools/workspace/src/generate/official-plugins.ts, which writes LF.
apps/studio/src/default-theme.generated.scss text eol=lf
