{
  "name": "@shadergrove/workspace-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm check:i18n && pnpm check:fonts && pnpm check:ipc && pnpm check:plugins",
    "check:i18n": "tsx src/check/i18n.ts",
    "check:fonts": "tsx src/check/fonts.ts",
    "check:ipc": "tsx src/check/ipc.ts",
    "check:plugins": "tsx src/generate/official-plugins.ts --check",
    "generate:fonts": "tsx src/generate/fonts.ts",
    "generate:isf-plugin": "tsx src/generate/isf-plugin.ts",
    "generate:plugins": "tsx src/generate/official-plugins.ts",
    "smoke": "tsx src/smoke.ts",
    "smoke:website": "tsx src/website-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../../plugins/official/tsconfig.json",
    "smoke:ssr": "tsx src/ssr-smoke.ts",
    "verify:release": "tsx src/release/verify-assets.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "esbuild": "^0.25.12",
    "playwright": "^1.57.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vitest": "4.0.8",
    "yaml": "^2.9.1"
  },
  "nx": {
    "targets": {
      "check": {
        "cache": false
      },
      "check:i18n": {
        "cache": false
      },
      "check:fonts": {
        "cache": false
      },
      "check:ipc": {
        "cache": false
      },
      "check:plugins": {
        "cache": false
      },
      "generate:plugins": {
        "cache": false,
        "outputs": [
          "{workspaceRoot}/apps/studio/src/plugins"
        ]
      },
      "generate:fonts": {
        "cache": false,
        "outputs": [
          "{workspaceRoot}/apps/studio/src/app/editor/font-catalogue.ts"
        ]
      },
      "smoke": {
        "cache": false
      },
      "smoke:website": {
        "cache": false
      },
      "smoke:ssr": {
        "cache": false
      }
    }
  }
}
