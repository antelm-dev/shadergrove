{
  "name": "@shadergrove/maintenance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cli": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:pg --external:pg-native --outfile=../../dist/shadergrove/cli.mjs",
    "migrate:files": "tsx src/main.ts migrate-files",
    "claim:shaders": "tsx src/main.ts claim-shaders",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shadergrove/backend": "workspace:*",
    "@shadergrove/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "nx": {
    "targets": {
      "build:cli": {
        "outputs": [
          "{workspaceRoot}/dist/shadergrove/cli.mjs"
        ]
      }
    }
  }
}
