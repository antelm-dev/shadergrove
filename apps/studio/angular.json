{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": "56cc93d3-fa2e-4a94-8a1e-aebceab00ffd"
  },
  "newProjectRoot": "projects",
  "projects": {
    "shadergrove": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "outputPath": {
              "base": "../../dist/shadergrove"
            },
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": ["@angular/localize/init"],
            "assets": [
              {
                "glob": "plugin-sandbox.js",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "*.json",
                "input": "src/plugins",
                "output": "/plugins"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource-variable/jetbrains-mono/wght.css",
              "node_modules/material-symbols/outlined.css",
              "src/styles.scss",
              "node_modules/monaco-editor/min/vs/editor/editor.main.css"
            ],
            "loader": {
              ".ttf": "file"
            },
            "server": "src/main.server.ts",
            "outputMode": "server",
            "externalDependencies": [
              "pg",
              "pg-native",
              "node:sqlite",
              "cloudflare:sockets",
              "class-validator",
              "class-transformer",
              "@nestjs/swagger",
              "@nestjs/websockets/socket-module",
              "@nestjs/microservices",
              "@nestjs/microservices/microservices-module"
            ],
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server/index.ts"
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.0MB",
                  "maximumError": "2.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "prebundle": {
              "exclude": [
                "@shadergrove/shared",
                "@nestjs/common",
                "@nestjs/core",
                "@nestjs/platform-express",
                "drizzle-orm",
                "nodemailer",
                "reflect-metadata"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "shadergrove:build:production"
            },
            "development": {
              "buildTarget": "shadergrove:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "desktop": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.desktop.ts",
            "outputPath": {
              "base": "../../dist-web",
              "browser": ""
            },
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": ["@angular/localize/init"],
            "assets": [
              {
                "glob": "plugin-sandbox.js",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "*.json",
                "input": "src/plugins",
                "output": "/plugins"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource-variable/jetbrains-mono/wght.css",
              "node_modules/material-symbols/outlined.css",
              "src/styles.scss",
              "node_modules/monaco-editor/min/vs/editor/editor.main.css"
            ],
            "loader": {
              ".ttf": "file"
            },
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.0MB",
                  "maximumError": "2.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "desktop-serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "prebundle": {
              "exclude": ["@shadergrove/shared"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "shadergrove:desktop:production"
            },
            "development": {
              "buildTarget": "shadergrove:desktop:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "shadergrove:build:development",
            "runner": "vitest",
            "exclude": ["src/desktop/**", "src/server/**"]
          }
        }
      }
    }
  }
}
