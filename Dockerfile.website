# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build

WORKDIR /app
ENV CI=true

# renovate: datasource=npm depName=pnpm
RUN npm install --global pnpm@10.28.2

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/website/package.json ./apps/website/
COPY libs/brand/package.json ./libs/brand/
COPY libs/shared/package.json ./libs/shared/

RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --filter @shadergrove/website... --frozen-lockfile

COPY apps/website ./apps/website
COPY libs/brand ./libs/brand
COPY libs/shared ./libs/shared

ARG NEXT_PUBLIC_STUDIO_URL
ENV NEXT_PUBLIC_STUDIO_URL=${NEXT_PUBLIC_STUDIO_URL}
ARG NEXT_PUBLIC_RELEASES_API_URL
ENV NEXT_PUBLIC_RELEASES_API_URL=${NEXT_PUBLIC_RELEASES_API_URL}

RUN pnpm --filter @shadergrove/website build

FROM nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94 AS runtime

# Apply Alpine security fixes that may precede a rebuilt upstream nginx image.
RUN apk upgrade --no-cache

COPY ops/website/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/website/out /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
