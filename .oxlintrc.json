{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "dist-main/**",
    "dist-renderer/**",
    "dist-web/**",
    "release/**",
    "data/**",
    "third_party/**",
    ".tmp/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "apps/studio-e2e/.auth/**",
    "apps/studio/src/desktop/contracts/ipc-bridge.ts",
    "**/.next/**",
    "apps/website/out/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/studio/src/app/**",
        "apps/studio/src/main.ts",
        "apps/studio/src/main.desktop.ts",
        "apps/studio/src/main.server.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Electron APIs belong in src/desktop; the Angular renderer uses src/desktop/contracts types."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/server",
                  "**/server/**",
                  "**/desktop/main",
                  "**/desktop/main/**",
                  "**/desktop/preload",
                  "**/desktop/preload/**"
                ],
                "message": "The Angular app must not import Node entry points from src/server or src/desktop."
              },
              {
                "group": ["**/desktop/contracts/ipc-bridge", "**/desktop/contracts/ipc-bridge.*"],
                "allowTypeImports": true,
                "message": "The generated IPC bridge runs in the Electron preload; the Angular renderer may import its types only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/website/**"],
      "plugins": ["typescript", "react", "jsx-a11y", "nextjs"]
    }
  ]
}
